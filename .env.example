# SupplyChainX Environment Configuration Template

# Server Configuration
PROJECT_NAME="SupplyChainX"
VERSION="1.0.0"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & JWT
SECRET_KEY="supplychainx-production-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (SQLite default, change to PostgreSQL for production)
DATABASE_URL="sqlite:///./supplychainx.db"

# Web3 / Blockchain Provider (Ganache or Ethereum RPC node)
WEB3_PROVIDER_URI="http://127.0.0.1:8545"
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# GenAI & LLM Key (Optional - Fallbacks to deterministic knowledge engine if omitted)
GEMINI_API_KEY=""

# Notification Webhook Target (Optional)
DEFAULT_WEBHOOK_URL="https://httpbin.org/post"
